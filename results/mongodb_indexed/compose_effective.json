{
  "name": "population-dbms-benchmark",
  "networks": {
    "default": {
      "name": "population-dbms-benchmark_default",
      "ipam": {}
    }
  },
  "services": {
    "client": {
      "build": {
        "context": "D:\\Projects\\dbms",
        "dockerfile": "Dockerfile"
      },
      "cpus": 2,
      "command": null,
      "entrypoint": [
        "python",
        "-m",
        "benchmark.cli"
      ],
      "environment": {
        "MYSQL_ROOT_PASSWORD": "[REDACTED]",
        "PYTHONUNBUFFERED": "1"
      },
      "mem_limit": "2147483648",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "bind",
          "source": "D:\\Projects\\dbms\\datasets\\population_10000000",
          "target": "/dataset",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "D:\\Projects\\dbms\\results",
          "target": "/results",
          "bind": {}
        }
      ]
    },
    "mongodb": {
      "cpus": 4,
      "command": [
        "mongod",
        "--wiredTigerCacheSizeGB",
        "2",
        "--bind_ip_all"
      ],
      "entrypoint": null,
      "healthcheck": {
        "test": [
          "CMD",
          "mongosh",
          "--quiet",
          "--eval",
          "db.adminCommand({ping:1}).ok || quit(1)"
        ],
        "timeout": "5s",
        "interval": "5s",
        "retries": 60
      },
      "image": "mongo:8.0",
      "mem_limit": "4294967296",
      "memswap_limit": "4294967296",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "mongo_data",
          "target": "/data/db",
          "volume": {}
        }
      ]
    },
    "mysql": {
      "cpus": 4,
      "command": [
        "--innodb-buffer-pool-size=2147483648",
        "--innodb-flush-log-at-trx-commit=1",
        "--skip-log-bin",
        "--character-set-server=utf8mb4",
        "--collation-server=utf8mb4_0900_bin",
        "--max-connections=150"
      ],
      "entrypoint": null,
      "environment": {
        "MYSQL_DATABASE": "population_db",
        "MYSQL_ROOT_HOST": "%",
        "MYSQL_ROOT_PASSWORD": "[REDACTED]"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "mysql --protocol=TCP -h 127.0.0.1 -uroot -p\"$$MYSQL_ROOT_PASSWORD\" -e \"SELECT 1\" >/dev/null 2>&1"
        ],
        "timeout": "5s",
        "interval": "5s",
        "retries": 60
      },
      "image": "mysql:8.4",
      "mem_limit": "4294967296",
      "memswap_limit": "4294967296",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "mysql_data",
          "target": "/var/lib/mysql",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "mongo_data": {
      "name": "population-dbms-benchmark_mongo_data"
    },
    "mysql_data": {
      "name": "population-dbms-benchmark_mysql_data"
    }
  }
}